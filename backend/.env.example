DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=guardian_zero3
DB_PORT=3306

SECRET_KEY=

# Correo remitente, debe estar verificado como "sender" en tu cuenta de Brevo
MAIL_USERNAME=
# API key de Brevo (brevo.com > SMTP & API > API Keys)
BREVO_API_KEY=

# URL pública donde queda expuesto este backend (usada para armar el link
# de verificación de correo). En Render es la URL que te asigna el servicio,
# ej. https://guardianzero-backend.onrender.com
SERVER_URL=http://localhost:5000
